# Choose "ollama" for a free local chatbot, or "openai" for the OpenAI API.
CHAT_PROVIDER=ollama

# Ollama runs locally and requires no API key. Download a model with, for example:
# ollama pull gemma3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Optional cloud assistant. Gemini's free tier has usage limits and may use
# submitted prompts to improve Google products. Never paste private borrower data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI API configuration, retained for future use.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional password for model upload/delete. Required when exposing beyond localhost.
CREDITSCOPE_ADMIN_TOKEN=
# Import source, used only by scripts/import_project.py
CREDITSCOPE_SOURCE=../home-credit-default-risk




# Get-Process -Id (Get-NetTCPConnection -LocalPort 8000).OwningProcess | Stop-Process